# ==============================================================================
# CONTAQUES / LEAD OS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or server/.env and fill in your actual production values.
# NEVER commit .env files containing real secrets to version control.
# ==============================================================================

# Backend Server Configuration
PORT=5001

# PostgreSQL Database Connection
# Supported: Local PostgreSQL or Neon Serverless PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/contaque_db

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_signing_key_here
ADMIN_USER=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=Administrator

# Google Cloud & Search APIs
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_CUSTOM_SEARCH_API_KEY=your_google_custom_search_api_key_here
GOOGLE_CX=your_google_programmable_search_engine_cx_here

# Transactional Email Service (Brevo HTTP API)
BREVO_API_KEY=your_brevo_api_key_here

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:5001
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
